# Copy to .env (git-ignored) and fill in. Used by `make` and fastlane locally;
# CI reads the same names from GitHub Actions secrets.
DEVELOPMENT_TEAM=ABCDE12345
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
# base64 < AuthKey_XXXXXXXXXX.p8
APP_STORE_CONNECT_API_KEY_CONTENT=
MATCH_GIT_URL=https://github.com/<you>/ios-certificates.git
MATCH_PASSWORD=
