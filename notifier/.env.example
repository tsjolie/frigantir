# --- Required -----------------------------------------------------------------
# Shared secret the iOS app sends as "Authorization: Bearer <API_TOKEN>".
# Generate one with: openssl rand -hex 32
API_TOKEN=change-me

# APNs auth key (Apple Developer portal -> Keys). Use APNS_KEY_FILE *or* APNS_KEY.
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=TEAM123456
APNS_KEY_FILE=/run/secrets/apns.p8
# APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Fallback apns-topic if a device registers without a bundle_id.
# APNS_BUNDLE_ID=net.sjolie.frigateapp

# --- Event source -------------------------------------------------------------
# mqtt (default) or websocket
SOURCE=mqtt

# MQTT (SOURCE=mqtt) - the same broker Frigate publishes to
MQTT_HOST=mosquitto
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=frigate
# MQTT_TLS=false

# Frigate HTTP(S) URL. Required for SOURCE=websocket. In MQTT mode it's optional and
# used only to fetch notification thumbnails (together with PUBLIC_URL below).
# FRIGATE_URL=http://frigate:5000
# FRIGATE_USERNAME=
# FRIGATE_PASSWORD=
# FRIGATE_VERIFY_TLS=true

# --- Notification thumbnails ----------------------------------------------------
# The notifier's base URL as phones reach it (through your reverse proxy).
# Thumbnails are enabled only when both PUBLIC_URL and FRIGATE_URL are set.
# PUBLIC_URL=https://notify.example.com

# --- Optional -----------------------------------------------------------------
# Only notify for these cameras (comma separated). Empty = all cameras.
# CAMERAS=front_door,driveway
# Minimum seconds between pushes per device+camera. 0 = off.
COOLDOWN_SECONDS=0
DATA_DIR=/data
PORT=8080
LOG_LEVEL=INFO
