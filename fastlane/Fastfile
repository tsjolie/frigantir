# Lanes (run with `bundle exec fastlane <lane>`):
#   test          generate the project and run unit tests on a simulator
#
# Release builds come from Xcode Cloud (see README), not from here.
default_platform(:ios)

SCHEME = "FrigateApp"
PROJECT = "FrigateApp.xcodeproj"

platform :ios do
  desc "Regenerate FrigateApp.xcodeproj from project.yml"
  lane :generate do
    sh("cd .. && xcodegen generate")
  end

  desc "Run unit tests"
  lane :test do
    generate
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      device: ENV.fetch("TEST_DEVICE", "iPhone 17"),
      result_bundle: true,
      output_directory: "fastlane/test_output",
    )
  end
end
