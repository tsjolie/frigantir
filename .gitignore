# Generated by XcodeGen from project.yml
*.xcodeproj
*.xcworkspace
!*.xcworkspace/contents.xcworkspacedata

# Xcode / build output
DerivedData/
build/
*.xcresult
xcuserdata/
*.ipa
*.dSYM.zip

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output/
vendor/bundle/
.bundle/

# Secrets — never commit
.env
*.p8
*.p12
*.mobileprovision
AuthKey_*.p8

.DS_Store

# Editor swap/backup files (vim leaves .env.swp next to .env, with its contents)
*.swp
*.swo
*~

# Private planning / App Store submission notes (kept locally, not published)
docs/APP_STORE.md
docs/PROJECT_PLAN.md
